# Generate each value with a cryptographically secure password manager or:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATABASE_URL=postgresql://musearr:musearr@localhost:5432/musearr
MUSEARR_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MUSEARR_SESSION_SECRET=replace-with-32-byte-base64-key
MUSEARR_API_HOST=0.0.0.0
MUSEARR_API_PORT=4000
MUSEARR_WEB_ORIGIN=http://localhost:3000
MUSEARR_TRUST_PROXY=false
MUSEARR_RECONCILIATION_INTERVAL_MINUTES=360
# The configured local timezone and 24-hour time used for daily briefing schedules.
MUSEARR_TIMEZONE=UTC
MUSEARR_DAILY_BRIEF_TIME=08:00
# Optional: a Discord webhook receives the persisted daily briefing. This URL is never sent to browsers.
# MUSEARR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-id/replace-with-token
# Optional: enable Plex webhooks at /api/v1/webhooks/plex?secret=<value> with a 32+ character secret.
# MUSEARR_PLEX_WEBHOOK_SECRET=replace-with-a-long-random-value
# Optional: acquire missing playlist tracks through a Lidarr instance you run.
# Configured at runtime (owner only) via POST /api/v1/settings/lidarr; the API
# key is encrypted at rest with MUSEARR_ENCRYPTION_KEY. There is no env var.

# Optional: local AI. Off by default; the deterministic pipeline is unchanged
# unless all four are set. Musearr only talks to a model endpoint you host.
# MUSEARR_LOCAL_AI_ENABLED=false
# MUSEARR_LOCAL_AI_PROVIDER=ollama
# MUSEARR_LOCAL_AI_BASE_URL=http://localhost:11434
# MUSEARR_LOCAL_AI_MODEL=llama3.1

MUSEARR_API_URL=http://localhost:4000
# Used only with docker-compose.release.yml after a published container release.
# MUSEARR_IMAGE_VERSION=0.1.0
# MUSEARR_IMAGE_REPOSITORY=ghcr.io/rowkav09
